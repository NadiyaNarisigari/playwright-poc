# Copy this file to .env and fill it in. Never commit .env.
QA_EMAIL=
QA_PASSWORD=

# Bearer token for API tests, without the word "Bearer". Expires; refresh on a 401.
QA_API_TOKEN=

# CSM assigned to test customers (must exist in the app's CSM list)
QA_CSM_EMAIL=

# Optional: qa (default) | pre-prd | prod
# TEST_ENV=qa
# Required in addition when TEST_ENV=prod
# ALLOW_PROD=true