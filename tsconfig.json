{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true
  },
     "include": [
     "tests/**/*.ts",
     "config/**/*.ts",
     "pages/**/*.ts",
     "fixtures/**/*.ts",
     "test-data/**/*.ts",
     "playwright.config.ts"
   ]
}